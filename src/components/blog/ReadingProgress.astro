---
/* Thin gradient bar pinned to the top of the article page. */
---

<div aria-hidden="true" class="fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent">
  <div
    data-progress
    class="h-full origin-left scale-x-0 bg-gradient-to-r from-fuchsia-500 via-violet-400 to-cyan-400 transition-transform duration-150"
  >
  </div>
</div>

<script>
  const bar = document.querySelector("[data-progress]");
  if (bar) {
    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(1, window.scrollY / scrollable) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
