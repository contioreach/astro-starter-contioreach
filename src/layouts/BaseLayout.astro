---
import JsonLd from "../components/layout/JsonLd.astro";
import Seo from "../components/layout/Seo.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import "../styles/global.css";

const { seo, jsonLd = [] } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
    />

    <Seo {...seo} />
    {jsonLd.map((data) => <JsonLd data={data} />)}
  </head>
  <body
    class="flex min-h-full flex-col bg-zinc-950 font-sans text-zinc-100 selection:bg-fuchsia-500/30"
  >
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
